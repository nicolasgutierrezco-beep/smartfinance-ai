# Plantilla de variables de entorno de SmartFinance AI.
#
# Copia este archivo como .env y pon ahí los valores reales.
# El .env NUNCA se sube al repositorio: ya está en .gitignore.
# Este .env.example sí se sube, porque solo tiene nombres y valores de ejemplo.
#
# Estado actual: la funcionalidad de la semana 5 (calcular_limite_diario) es
# una cuenta matemática y NO necesita ninguna de estas variables. Se dejan
# declaradas desde ya porque la arquitectura del ADR-001 las va a necesitar
# cuando entren el backend, la base de datos, la cola y la API del LLM.

# --- Base de datos (ADR-001: PostgreSQL con cifrado) --------------------------
DATABASE_URL=postgresql://usuario:cambia_esta_clave@localhost:5432/smartfinance

# --- Cola de tareas (ADR-001: Redis + Celery) ----------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Motor de IA (ADR-001: API comercial de LLM, OpenAI o Gemini) --------------
LLM_PROVIDER=openai
LLM_API_KEY=pon_aqui_tu_clave_real

# --- Alertas (Firebase Cloud Messaging) -----------------------------------------
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
